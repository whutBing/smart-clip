#include "resource.h"
#include <windows.h>
#include "../include/version.h"

IDI_ICON1 ICON "clip.ico"
IDB_FOLDER_ICON RCDATA "images/file.png"
IDB_NOEXIST_ICON RCDATA "images/noexist.png"
IDB_TOPMOST_SELECTED RCDATA "images/topmost-selected.png"
IDB_TOPMOST_UNSELECTED RCDATA "images/topmost-unslected.png"
IDB_TEXT_ICON RCDATA "images/text.png"
IDB_NET_ICON RCDATA "images/net.png"
IDB_MAIL_ICON RCDATA "images/mail.png"
IDB_APP_ICON RCDATA "images/app-icon.png"

// 应用程序清单
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

// 版本信息（从 version.h 读取，与 AppxManifest.xml 保持同步）
VS_VERSION_INFO VERSIONINFO
 FILEVERSION APP_VERSION_MAJOR,APP_VERSION_MINOR,APP_VERSION_BUILD,APP_VERSION_REVISION
 PRODUCTVERSION APP_VERSION_MAJOR,APP_VERSION_MINOR,APP_VERSION_BUILD,APP_VERSION_REVISION
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "SmartClip"
            VALUE "FileDescription", "SmartClip - Windows Native Clipboard Manager"
            VALUE "FileVersion", APP_VERSION_STRING_A
            VALUE "InternalName", "SmartClip_Native"
            VALUE "LegalCopyright", "Copyright (C) 2024"
            VALUE "OriginalFilename", "SmartClip_Native.exe"
            VALUE "ProductName", "SmartClip"
            VALUE "ProductVersion", APP_VERSION_STRING_A
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
