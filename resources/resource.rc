#include "resource.h"
#include <windows.h>

IDI_ICON1 ICON "clip.ico"
IDB_FOLDER_ICON RCDATA "images/file.png"
IDB_NOEXIST_ICON RCDATA "images/noexist.png"
IDB_TOPMOST_SELECTED RCDATA "images/topmost-selected.png"
IDB_TOPMOST_UNSELECTED RCDATA "images/topmost-unslected.png"

// 应用程序清单
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

// 版本信息
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "SmartClip"
            VALUE "FileDescription", "SmartClip - Windows Native Clipboard Manager"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "SmartClip_Native"
            VALUE "LegalCopyright", "Copyright (C) 2024"
            VALUE "OriginalFilename", "SmartClip_Native.exe"
            VALUE "ProductName", "SmartClip"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
